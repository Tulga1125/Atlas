{
	admin off
	auto_https off
}

:{$PORT:8000} {
	header {
		Access-Control-Allow-Origin {$ALLOWED_ORIGIN}
		Access-Control-Allow-Headers "authorization, apikey, content-type, content-profile, accept-profile, prefer, range, x-client-info, x-supabase-api-version"
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Vary Origin
		-Server
	}
	@preflight method OPTIONS
	respond @preflight 204

	handle /health {
		respond "ok" 200
	}
	handle_path /auth/v1/* {
		reverse_proxy {$AUTH_UPSTREAM}
	}
	handle_path /rest/v1/* {
		reverse_proxy {$REST_UPSTREAM}
	}
	handle {
		respond 404
	}
}
