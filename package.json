{
  "name": "atlas-charts",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "secrets:check": "node scripts/check-secrets.mjs",
    "test:setup": "node scripts/prepare-test-stack.mjs",
    "test:upgrade": "node scripts/test-upgrade.mjs",
    "test:db": "node scripts/test-database.mjs",
    "test:db:plain": "node scripts/test-database-plain.mjs",
    "test:seed": "node scripts/seed-test-data.mjs",
    "test:schedule": "node scripts/test-schedule.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:build": "node scripts/build-test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "ATLAS_E2E_LIVE=1 playwright test",
    "test:restore": "node scripts/restore-drill.mjs",
    "db:types": "node scripts/database-types.mjs",
    "db:types:check": "node scripts/database-types.mjs --check",
    "ops:health": "node scripts/check-health.mjs",
    "artists:discover": "node scripts/import-artists.mjs",
    "artists:import": "node scripts/import-artists.mjs --apply"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "lucide-react": "1.33.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "supabase": "2.115.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
