# Copy to .env.local for development. Never commit real values.
# In the cloud environment, set these as secrets instead.

# Public site and database
NEXT_PUBLIC_SITE_URL=https://example.invalid
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Sources
APPLE_MUSIC_DEVELOPER_TOKEN=
YOUTUBE_API_KEY=

# AI (tag suggestions, comment sentiment, optional drafting)
ANTHROPIC_API_KEY=
ATLAS_AI_MODEL=claude-haiku-5-5
# D3: YouTube data is dashboard-only. "true" opens /api/v1/youtube publicly.
ATLAS_YOUTUBE_PUBLIC=false

# Health monitor (scripts/check-health.mjs)
ATLAS_HEALTH_URL=
ATLAS_HEALTH_LOG=
